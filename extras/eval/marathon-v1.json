{
  "version": 1,
  "description": "Recall-first field replay corpus using real marathon and road-race footage.",
  "detector": {
    "sample_interval": 0.25,
    "min_confidence": 0.15,
    "min_area_pct": 0.005,
    "min_movement_pct": 0.5,
    "min_directionality": 0.2,
    "subject_classes": "person,bicycle,car,motorbike,bus,truck",
    "yolo_backend": "auto"
  },
  "gates": {
    "min_transit_recall": 0.95,
    "max_negative_promotion_rate": 0.15,
    "min_identifier_exact_accuracy": 0.8,
    "max_identifier_false_positive_rate": 0.02,
    "max_identifier_p95_ms": 250
  },
  "sources": [
    {
      "id": "marathon-60s",
      "path": "marathon_clip_60s.mp4"
    },
    {
      "id": "norc-narrow-20s",
      "path": "field-replay-yolo-eval/NORC-NS-narrow-20s.mp4"
    }
  ],
  "cases": [
